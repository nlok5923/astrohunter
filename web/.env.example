# Backend API base URL used by the frontend.
#  - local dev: leave unset (defaults to http://127.0.0.1:8000 → `astrohunt serve`)
#  - split deploy: set to your backend's URL, e.g. https://astrohunt-api.example.com
#  - same-origin Vercel deploy (frontend + Python function together): set to "" (empty)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
